# Virtual environment - never commit
venv/
.venv/
env/

# Python bytecode / caches
__pycache__/
*.pyc
.pytest_cache/

# IDE / OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets (none are used in this project, kept as a safety net)
.env
*.key

# Generated on every run - regenerate locally, do not commit
screenshots/*.png
reports/*.html
reports/assets/

# Keep the (otherwise empty) folders in Git
!screenshots/.gitkeep
!reports/.gitkeep
